get_filename_component(CONSUMER_NAME "${CMAKE_CURRENT_SOURCE_DIR}" NAME)
set(CONSUMER_VERSION "1.0.0")
if(SECOND_CONSUMER)
    set(Microsoft.Windows.ImplementationLibrary_ROOT "/legacy/unchanged/root")
    set(MICROSOFT.WINDOWS.IMPLEMENTATIONLIBRARY_ROOT "/legacy/unchanged/upper-root")
    set(Microsoft.Windows.ImplementationLibrary_DIR "/legacy/unchanged/dir")
    set(Microsoft.Windows.ImplementationLibrary_FOUND FALSE)
    if(LEGACY_CONFLICT)
        set(CONSUMER_VERSION "2.0.0")
    endif()
endif()

set(CONSUMER_PACKAGES Microsoft.Windows.ImplementationLibrary "${CONSUMER_VERSION}")
if(WIN32)
    list(APPEND CONSUMER_PACKAGES Microsoft.WindowsAppSDK.ML "${CONSUMER_VERSION}")
endif()
add_nuget_packages(
    PACKAGES ${CONSUMER_PACKAGES}
    CONFIG_FILE "${FIXTURE_CONFIG}"
    LOCK_FILE "${LOCK_ROOT}/${CONSUMER_NAME}.packages.lock.json"
)

get_property(VERSION GLOBAL PROPERTY NUGET_VERSION-MICROSOFT_WINDOWS_IMPLEMENTATIONLIBRARY)
get_property(LOCATION GLOBAL PROPERTY NUGET_LOCATION-MICROSOFT_WINDOWS_IMPLEMENTATIONLIBRARY)
get_property(LOCAL_VERSION DIRECTORY PROPERTY NUGET_VERSION-MICROSOFT_WINDOWS_IMPLEMENTATIONLIBRARY)
file(TO_CMAKE_PATH "$ENV{NUGET_PACKAGES}/microsoft.windows.implementationlibrary/1.0.0" EXPECTED_LOCATION)
if(NOT VERSION STREQUAL "1.0.0" OR NOT LOCATION STREQUAL EXPECTED_LOCATION OR LOCAL_VERSION)
    message(FATAL_ERROR "Legacy version/location properties are not global.")
endif()

if(SECOND_CONSUMER)
    if(NOT Microsoft.Windows.ImplementationLibrary_FOUND
        OR NOT Microsoft.Windows.ImplementationLibrary_ROOT STREQUAL "/legacy/unchanged/root"
        OR NOT MICROSOFT.WINDOWS.IMPLEMENTATIONLIBRARY_ROOT STREQUAL "/legacy/unchanged/upper-root"
        OR NOT Microsoft.Windows.ImplementationLibrary_DIR STREQUAL "/legacy/unchanged/dir")
        message(FATAL_ERROR "Legacy repeat call changed discovery rather than only setting FOUND.")
    endif()
else()
    cmake_path(SET EXPECTED_CONFIG NORMALIZE "${CMAKE_CURRENT_LIST_DIR}/../../../overlay/microsoft.windows.implementationlibrary/")
    if(NOT MICROSOFT.WINDOWS.IMPLEMENTATIONLIBRARY_ROOT STREQUAL EXPECTED_CONFIG
        OR DEFINED Microsoft.Windows.ImplementationLibrary_ROOT
        OR DEFINED Microsoft.Windows.ImplementationLibrary_DIR)
        message(FATAL_ERROR "Legacy discovery did not reach the caller: ${MICROSOFT.WINDOWS.IMPLEMENTATIONLIBRARY_ROOT}")
    endif()
    find_package(Microsoft.Windows.ImplementationLibrary CONFIG REQUIRED)
    if(WIN32)
        find_package(Microsoft.WindowsAppSDK.ML CONFIG REQUIRED)
    endif()
endif()

get_target_property(IS_IMPORTED Microsoft.Windows.ImplementationLibrary IMPORTED)
get_target_property(INCLUDES Microsoft.Windows.ImplementationLibrary INTERFACE_INCLUDE_DIRECTORIES)
if(IS_IMPORTED OR NOT "${EXPECTED_LOCATION}/include" IN_LIST INCLUDES)
    message(FATAL_ERROR "Legacy WIL target no longer has its regular interface/includes.")
endif()
target_compile_definitions(Microsoft.Windows.ImplementationLibrary INTERFACE LEGACY_INTERFACE_MUTATION)

if(WIN32)
    foreach(PACKAGE IN ITEMS Microsoft.Windows.CppWinRT Microsoft.WindowsAppSDK.Foundation Microsoft.WindowsAppSDK.InteractiveExperiences Microsoft.WindowsAppSDK.ML)
        get_target_property(IS_IMPORTED "${PACKAGE}" IMPORTED)
        get_target_property(SOURCES "${PACKAGE}" SOURCES)
        get_target_property(INCLUDES "${PACKAGE}" INTERFACE_INCLUDE_DIRECTORIES)
        set(EXPECTED_OUTPUT "${CMAKE_BINARY_DIR}/__cppwinrt/${PACKAGE}")
        if(IS_IMPORTED OR NOT SOURCES STREQUAL "${EXPECTED_OUTPUT}/output.log" OR NOT EXPECTED_OUTPUT IN_LIST INCLUDES)
            message(FATAL_ERROR "Legacy projection target/layout changed for ${PACKAGE}.")
        endif()
    endforeach()
    foreach(PACKAGE IN ITEMS Microsoft.WindowsAppSDK.Foundation_Bootstrap Microsoft.WindowsAppSDK.Foundation_SelfContainedRuntime Microsoft.WindowsAppSDK.InteractiveExperiences_SelfContainedRuntime Microsoft.WindowsAppSDK.ML_SelfContainedRuntime)
        get_target_property(IS_GLOBAL "${PACKAGE}" IMPORTED_GLOBAL)
        if(NOT IS_GLOBAL)
            message(FATAL_ERROR "Legacy imported target ${PACKAGE} lost GLOBAL visibility.")
        endif()
    endforeach()
    foreach(PACKAGE IN ITEMS Microsoft.WindowsAppSDK.Runtime Microsoft.WindowsAppSDK.Foundation_Framework Microsoft.WindowsAppSDK.Foundation_DynamicDependencyBootstrap Microsoft.WindowsAppSDK.Foundation_DeploymentManagerBootstrap Microsoft.WindowsAppSDK.Foundation_SelfContained Microsoft.WindowsAppSDK.InteractiveExperiences_SelfContained Microsoft.WindowsAppSDK.ML_Framework Microsoft.WindowsAppSDK.ML_SelfContained)
        get_target_property(IS_IMPORTED "${PACKAGE}" IMPORTED)
        if(IS_IMPORTED)
            message(FATAL_ERROR "Legacy interface ${PACKAGE} unexpectedly became imported.")
        endif()
    endforeach()
endif()
